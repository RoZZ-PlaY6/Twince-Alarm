# Keep the Gradle wrapper tracked so a Linux CI checkout can build the APK:
#   gradlew
#   gradlew.bat
#   gradle/wrapper/gradle-wrapper.jar
# gradlew is LF and matches the Flutter 3.47.8 wrapper. Do not ignore it.

